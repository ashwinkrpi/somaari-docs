{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(node:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm create astro:*)",
      "Bash(npm view:*)",
      "Bash(npm ls:*)",
      "Bash(npm outdated:*)",
      "Bash(npx astro:*)",
      "Bash(npx --yes create-astro:*)",
      "Bash(npx --yes wrangler@4:*)",
      "Bash(npx wrangler:*)",
      "Bash(npx --yes playwright@1:*)",
      "Bash(npx playwright:*)",
      "Bash(npx --yes lighthouse@12:*)",
      "Bash(npx --yes @axe-core/cli:*)",
      "Bash(npx --yes pagefind:*)",
      "Bash(python3:*)",
      "Bash(git:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(gh run:*)",
      "Bash(crontab:*)",
      "Bash(~/.local/bin/somaari-server run-job:*)",
      "Bash(chmod +x scripts/:*)",
      "Bash(bash scripts/:*)",
      "Bash(FORCE=1 bash scripts/:*)",
      "Bash(which:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(jq:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(touch:*)",
      "Bash(date:*)",
      "Bash(cd:*)",
      "Bash(rm -rf dist:*)",
      "Bash(rm -rf .astro:*)",
      "Bash(rm -rf .wrangler:*)",
      "Bash(rm -rf public/theme:*)",
      "Bash(rm -rf src/content/docs/somaari-:*)",
      "Bash(rm -rf node_modules:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh secret:*)",
      "Bash(npx wrangler delete:*)",
      "Bash(npx --yes wrangler@4 delete:*)",
      "Bash(npx wrangler pages project delete:*)",
      "Bash(npx --yes wrangler@4 pages project delete:*)",
      "Bash(sudo:*)",
      "Bash(crontab -r:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(~/.config/.wrangler/**)"
    ],
    "additionalDirectories": [
      "../somaari-common",
      "../somaari-website/somaari-site",
      "../somaari-blog",
      "../somaari-disk",
      "../somaari-plan",
      "../somaari-trip",
      "../../project-logs",
      "../../scripts/project-index"
    ]
  }
}
